// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth & account shell (build-order step 2) -----------------------------
//
// Identity/auth (email verification, password/OAuth, sessions) is handled by
// Supabase Auth, not by these models. `User.id` matches the corresponding
// `auth.users.id` UUID; app code creates the `User` row after Supabase Auth
// creates the account.

enum UserRole {
  BEATMAKER
  AUDIENCE

  // Reserved for Phase 3 (Sponsor Portal / Industry Portal). Staff-onboarded
  // only (admin tool / seed script) — there is no signup UI for these roles.
  SPONSOR
  INDUSTRY
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  handle    String   @unique
  avatarUrl String?
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Staff permission, orthogonal to `role` — an admin can also be a
  // BEATMAKER. No signup UI grants this; set only via direct DB access
  // (see docs/04-data-model.md's step 6 resolved decision).
  isAdmin Boolean @default(false)

  beatmakerProfile BeatmakerProfile?
  sponsorProfile   SponsorProfile?
  tracks           Track[]
  submissions      Submission[]
  judgments        Judgment[]
  judgeAssignments BattleJudge[]
  battleResults    BattleResult[]

  following     Follow[]                  @relation("Following")
  followers     Follow[]                  @relation("Followers")
  notifications Notification[]
  conversations ConversationParticipant[]
  messages      Message[]
  comments      Comment[]
  disputesFiled Dispute[]
  royaltySplits RoyaltySplit[]

  tournamentEntries       TournamentEntrant[]
  roundMatchesAsUserA     RoundMatch[]        @relation("RoundMatchUserA")
  roundMatchesAsUserB     RoundMatch[]        @relation("RoundMatchUserB")
  roundMatchesAsByeWinner RoundMatch[]        @relation("RoundMatchByeWinner")
}

model BeatmakerProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio      String?
  location String?
  genres   String[] @default([])

  // Staff-set only — no self-serve UI, same pattern as User.isAdmin. Toggled
  // from /admin/users.
  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Battle loop core (build-order step 4) ----------------------------------

enum JudgingType {
  COMMUNITY
  JUDGE_PANEL
  HYBRID
}

enum BattleStatus {
  UPCOMING
  OPEN
  PENDING
  COMPLETED
  ERROR
}

model Battle {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  genre       String?
  description String?
  bpm         Int?
  status      BattleStatus @default(UPCOMING)
  entryFee  Decimal      @default(25) @db.Decimal(10, 2)
  prizePool Decimal?     @db.Decimal(10, 2)

  startsAt           DateTime
  durationMinutes    Int      @default(60)
  submissionDeadline DateTime
  // When community/judge voting closes. Optional — a battle without one is
  // closed out manually by an admin moving it to COMPLETED.
  judgingDeadline    DateTime?

  judgingType JudgingType @default(COMMUNITY)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Nullable — most Battles aren't sponsored. A real column (unlike
  // roundMatch below): one sponsorship can cover many Battles, so this
  // can't be relation-only the way the Tournament back-reference is.
  sponsorshipId String?      @db.Uuid
  sponsorship   Sponsorship? @relation(fields: [sponsorshipId], references: [id], onDelete: SetNull)

  submissions Submission[]
  judgments   Judgment[]
  judges      BattleJudge[]
  results     BattleResult[]
  comments    Comment[]
  disputes    Dispute[]

  // Relation-only — the FK lives on RoundMatch, no column added here. Null
  // for every ordinary (non-tournament) Battle.
  roundMatch RoundMatch?
}

enum SubmissionStatus {
  PENDING_REVIEW
  ACCEPTED
  FLAGGED
  DISQUALIFIED
}

model Submission {
  id       String @id @default(uuid()) @db.Uuid
  battleId String @db.Uuid
  battle   Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trackId String @unique @db.Uuid
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  status      SubmissionStatus @default(PENDING_REVIEW)
  submittedAt DateTime         @default(now())

  judgments Judgment[]
  result    BattleResult?
  disputes  Dispute[]

  @@unique([battleId, userId])
}

// The actual audio asset. Licensing/commercial fields (Non-Exclusive/
// Exclusive/Stems, DSP-released, etc.) are deferred to Phase 2 (step 7) —
// this only covers what a battle submission needs: a playable track.
model Track {
  id            String   @id @default(uuid()) @db.Uuid
  title         String
  audioUrl      String
  waveformPeaks Json?
  durationSec   Int
  creatorId     String   @db.Uuid
  creator       User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  submission Submission?
  comments   Comment[]
  releases   ReleaseTrack[]
}

// One participant's outcome in a Battle, aggregated from that battle's
// Judgment rows per its judgingType. Global/genre rank and win-loss record
// (Charts, Beatmaker Profile) are computed by querying BattleResult rather
// than stored as counters on BeatmakerProfile, so there's nothing to fall
// out of sync.
model BattleResult {
  id           String     @id @default(uuid()) @db.Uuid
  battleId     String     @db.Uuid
  battle       Battle     @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionId String     @unique @db.Uuid
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  placement Int?
  score     Float?
  advanced  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([battleId, userId])
}

enum JudgeRole {
  COMMUNITY
  JUDGE
}

model Judgment {
  id           String     @id @default(uuid()) @db.Uuid
  battleId     String     @db.Uuid
  battle       Battle     @relation(fields: [battleId], references: [id], onDelete: Cascade)
  submissionId String     @db.Uuid
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judgedById   String     @db.Uuid
  judgedBy     User       @relation(fields: [judgedById], references: [id], onDelete: Cascade)

  judgeRole JudgeRole
  score     Int
  criteria  Json?

  createdAt DateTime @default(now())

  @@unique([submissionId, judgedById])
}

// Judge assignments — only used when Battle.judgingType != COMMUNITY.
model BattleJudge {
  id       String @id @default(uuid()) @db.Uuid
  battleId String @db.Uuid
  battle   Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([battleId, userId])
}

// --- Social/retention layer (build-order step 5) ---------------------------

model Follow {
  id          String @id @default(uuid()) @db.Uuid
  followerId  String @db.Uuid
  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String @db.Uuid
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
}

// Activity Feed has no table of its own — it's computed by querying
// BattleResult + Follow at read time (see lib/activity.ts), same reasoning
// as BattleResult itself: nothing to keep in sync.

enum NotificationType {
  BATTLE_RESULT
  NEW_FOLLOWER
  SUBMISSION_STATUS
}

model Notification {
  id      String           @id @default(uuid()) @db.Uuid
  userId  String           @db.Uuid
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  payload Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())
}

// A participants join table rather than fixed userAId/userBId columns, so
// group conversations (sponsors, judges) don't need a redesign later.
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @db.Uuid
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  body      String
  createdAt DateTime @default(now())
}

// Attachable to a Battle or Track — exactly one of battleId/trackId should
// be set (Prisma/Postgres can't enforce that at the schema level, so it's
// validated in application code). No releaseId yet — Release isn't modeled.
model Comment {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  body   String

  battleId String? @db.Uuid
  battle   Battle? @relation(fields: [battleId], references: [id], onDelete: Cascade)
  trackId  String? @db.Uuid
  track    Track?  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  parentId String?   @db.Uuid
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
}

// --- Admin (build-order step 6) ---------------------------------------------

enum DisputeStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Filed against a Battle or a Submission — at most one of battleId/
// submissionId is expected to be set (validated in application code, same
// as Comment's battleId/trackId).
model Dispute {
  id        String @id @default(uuid()) @db.Uuid
  filedById String @db.Uuid
  filedBy   User   @relation(fields: [filedById], references: [id], onDelete: Cascade)

  battleId     String?     @db.Uuid
  battle       Battle?     @relation(fields: [battleId], references: [id], onDelete: Cascade)
  submissionId String?     @db.Uuid
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  reason     String
  status     DisputeStatus @default(OPEN)
  resolution String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Releases (non-commerce catch-up work) ---------------------------------

enum ReleaseStatus {
  DRAFT
  SCHEDULED
  LIVE
}

model Release {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  season      String?
  status      ReleaseStatus @default(DRAFT)
  releaseDate DateTime?

  spotifyUrl    String?
  appleMusicUrl String?
  tidalUrl      String?

  tracks        ReleaseTrack[]
  royaltySplits RoyaltySplit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ordered tracklist — a track can appear on more than one release over time.
model ReleaseTrack {
  id        String  @id @default(uuid()) @db.Uuid
  releaseId String  @db.Uuid
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  trackId   String  @db.Uuid
  track     Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position  Int

  @@unique([releaseId, trackId])
}

// Recorded config only — nothing here moves money. Real payout execution is
// Wallet/Transaction, step 7. userId null = platform's share. No SoundKit
// reference — SoundKit isn't modeled yet (Phase 2).
model RoyaltySplit {
  id         String   @id @default(uuid()) @db.Uuid
  releaseId  String   @db.Uuid
  release    Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  percentage Decimal  @db.Decimal(5, 2)
  createdAt  DateTime @default(now())
}

// --- Tournaments (non-commerce catch-up work) ------------------------------
//
// Composes ordinary, always-1-shot Battle rows into rounds/matchups —
// Battle itself gets no bracket/round scalar fields (see docs/04-data-model.md's
// resolved decision), only the relation-only Battle.roundMatch back-reference.
// Round shells for every round are created up front (so the bracket shape is
// visible immediately); a round's actual pairing + Battle rows are generated
// only when that round starts — Round 1 at Tournament creation, later rounds
// via an explicit admin "start next round" action once the prior round is
// fully resolved. Season-based auto-qualification isn't built — entrants are
// admin-seeded, since there's no Season entity yet.

enum TournamentStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RoundStatus {
  PENDING // shell only — pairing/Battle not generated yet
  ACTIVE // pairing generated, Battle(s) in progress (or all byes, already resolved)
  COMPLETED
  CANCELLED
}

model Tournament {
  id        String           @id @default(uuid()) @db.Uuid
  title     String
  status    TournamentStatus @default(UPCOMING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  entrants TournamentEntrant[]
  rounds   Round[]
}

// The admin-chosen initial seed list — Round 1's participants, in seed order.
model TournamentEntrant {
  id           String     @id @default(uuid()) @db.Uuid
  tournamentId String     @db.Uuid
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  seed         Int

  @@unique([tournamentId, userId])
  @@unique([tournamentId, seed])
}

model Round {
  id           String      @id @default(uuid()) @db.Uuid
  tournamentId String      @db.Uuid
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  roundNumber  Int
  // "Quarterfinal" / "Semifinal" / "Final" / "Round N" — computed once at
  // Tournament creation from the entrant count, not re-derived later.
  label        String
  status       RoundStatus @default(PENDING)

  matches RoundMatch[]

  @@unique([tournamentId, roundNumber])
}

// Exactly one of userA/userB may be null — a bye. battleId is set the
// instant this match's real Battle is created; both happen together when
// the round starts, so there's never a "placeholder Battle" state.
model RoundMatch {
  id       String @id @default(uuid()) @db.Uuid
  roundId  String @db.Uuid
  round    Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  // Bracket slot within the round, 1-indexed — determines pairing into the
  // next round (positions 1&2 feed the next round's position 1, etc.).
  position Int

  userAId String? @db.Uuid
  userA   User?   @relation("RoundMatchUserA", fields: [userAId], references: [id])
  userBId String? @db.Uuid
  userB   User?   @relation("RoundMatchUserB", fields: [userBId], references: [id])

  // Bye only: exactly one of userA/userB set, no Battle ever created for
  // this slot — the present user advances automatically. Left null (along
  // with userA/userB) when this bracket slot has no entrant at all.
  byeWinnerId String? @db.Uuid
  byeWinner   User?   @relation("RoundMatchByeWinner", fields: [byeWinnerId], references: [id])

  battleId String? @unique @db.Uuid
  battle   Battle? @relation(fields: [battleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([roundId, position])
}

// --- Sponsor Portal (pulled forward from Phase 3, non-commerce catch-up
// work) ----------------------------------------------------------------
//
// Sponsor accounts are staff-onboarded, not self-serve (see docs/04-data-
// model.md's resolved decision on question 1) — there's no signup path for
// UserRole.SPONSOR. Staff creates the Supabase Auth user directly (via
// lib/supabase/admin.ts) and the matching User/SponsorProfile rows in the
// same action, then the sponsor sets their own password via an emailed
// invite link, same infra the rest of auth already uses.

model SponsorProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName  String
  contactName  String?
  contactEmail String?
  notes        String? // internal admin notes — never shown to the sponsor

  sponsorships Sponsorship[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One signed engagement — the package a sponsor actually bought, not the
// generic pricing catalog on the public /sponsors pitch page. Covers zero
// or more Battles.
model Sponsorship {
  id        String         @id @default(uuid()) @db.Uuid
  sponsorId String         @db.Uuid
  sponsor   SponsorProfile @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  // Free text, e.g. "Season Partner" — matches Battle.genre/Release.season's
  // precedent rather than a rigid enum tied to the pitch page's 3 examples.
  packageName       String?
  amountContributed Decimal?  @db.Decimal(10, 2)
  // Non-cash contributions, e.g. "3 plugin licenses + 1 controller for prizes".
  productNotes      String?
  startDate         DateTime?
  endDate           DateTime?

  battles Battle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth & account shell (build-order step 2) -----------------------------
//
// Identity/auth (email verification, password/OAuth, sessions) is handled by
// Supabase Auth, not by these models. `User.id` matches the corresponding
// `auth.users.id` UUID; app code creates the `User` row after Supabase Auth
// creates the account.

enum UserRole {
  BEATMAKER
  AUDIENCE

  // Reserved for Phase 3 (Sponsor Portal / Industry Portal). Staff-onboarded
  // only (admin tool / seed script) — there is no signup UI for these roles.
  SPONSOR
  INDUSTRY
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  handle    String   @unique
  avatarUrl String?
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Staff permission, orthogonal to `role` — an admin can also be a
  // BEATMAKER. No signup UI grants this; set only via direct DB access
  // (see docs/04-data-model.md's step 6 resolved decision).
  isAdmin Boolean @default(false)

  beatmakerProfile BeatmakerProfile?
  tracks           Track[]
  submissions      Submission[]
  judgments        Judgment[]
  judgeAssignments BattleJudge[]
  battleResults    BattleResult[]

  following     Follow[]                  @relation("Following")
  followers     Follow[]                  @relation("Followers")
  notifications Notification[]
  conversations ConversationParticipant[]
  messages      Message[]
  comments      Comment[]
  disputesFiled Dispute[]
}

model BeatmakerProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Battle loop core (build-order step 4) ----------------------------------

enum JudgingType {
  COMMUNITY
  JUDGE_PANEL
  HYBRID
}

enum BattleStatus {
  UPCOMING
  OPEN
  PENDING
  COMPLETED
  ERROR
}

model Battle {
  id        String       @id @default(uuid()) @db.Uuid
  title     String
  genre     String?
  status    BattleStatus @default(UPCOMING)
  entryFee  Decimal      @default(25) @db.Decimal(10, 2)
  prizePool Decimal?     @db.Decimal(10, 2)

  startsAt           DateTime
  durationMinutes    Int      @default(60)
  submissionDeadline DateTime

  judgingType JudgingType @default(COMMUNITY)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  submissions Submission[]
  judgments   Judgment[]
  judges      BattleJudge[]
  results     BattleResult[]
  comments    Comment[]
  disputes    Dispute[]
}

enum SubmissionStatus {
  PENDING_REVIEW
  ACCEPTED
  FLAGGED
  DISQUALIFIED
}

model Submission {
  id       String @id @default(uuid()) @db.Uuid
  battleId String @db.Uuid
  battle   Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trackId String @unique @db.Uuid
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  status      SubmissionStatus @default(PENDING_REVIEW)
  submittedAt DateTime         @default(now())

  judgments Judgment[]
  result    BattleResult?
  disputes  Dispute[]

  @@unique([battleId, userId])
}

// The actual audio asset. Licensing/commercial fields (Non-Exclusive/
// Exclusive/Stems, DSP-released, etc.) are deferred to Phase 2 (step 7) —
// this only covers what a battle submission needs: a playable track.
model Track {
  id            String   @id @default(uuid()) @db.Uuid
  title         String
  audioUrl      String
  waveformPeaks Json?
  durationSec   Int
  creatorId     String   @db.Uuid
  creator       User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  submission Submission?
  comments   Comment[]
}

// One participant's outcome in a Battle, aggregated from that battle's
// Judgment rows per its judgingType. Global/genre rank and win-loss record
// (Charts, Beatmaker Profile) are computed by querying BattleResult rather
// than stored as counters on BeatmakerProfile, so there's nothing to fall
// out of sync.
model BattleResult {
  id           String     @id @default(uuid()) @db.Uuid
  battleId     String     @db.Uuid
  battle       Battle     @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionId String     @unique @db.Uuid
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  placement Int?
  score     Float?
  advanced  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([battleId, userId])
}

enum JudgeRole {
  COMMUNITY
  JUDGE
}

model Judgment {
  id           String     @id @default(uuid()) @db.Uuid
  battleId     String     @db.Uuid
  battle       Battle     @relation(fields: [battleId], references: [id], onDelete: Cascade)
  submissionId String     @db.Uuid
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judgedById   String     @db.Uuid
  judgedBy     User       @relation(fields: [judgedById], references: [id], onDelete: Cascade)

  judgeRole JudgeRole
  score     Int
  criteria  Json?

  createdAt DateTime @default(now())

  @@unique([submissionId, judgedById])
}

// Judge assignments — only used when Battle.judgingType != COMMUNITY.
model BattleJudge {
  id       String @id @default(uuid()) @db.Uuid
  battleId String @db.Uuid
  battle   Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([battleId, userId])
}

// --- Social/retention layer (build-order step 5) ---------------------------

model Follow {
  id          String @id @default(uuid()) @db.Uuid
  followerId  String @db.Uuid
  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String @db.Uuid
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
}

// Activity Feed has no table of its own — it's computed by querying
// BattleResult + Follow at read time (see lib/activity.ts), same reasoning
// as BattleResult itself: nothing to keep in sync.

enum NotificationType {
  BATTLE_RESULT
  NEW_FOLLOWER
  SUBMISSION_STATUS
}

model Notification {
  id      String           @id @default(uuid()) @db.Uuid
  userId  String           @db.Uuid
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  payload Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())
}

// A participants join table rather than fixed userAId/userBId columns, so
// group conversations (sponsors, judges) don't need a redesign later.
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @db.Uuid
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  body      String
  createdAt DateTime @default(now())
}

// Attachable to a Battle or Track — exactly one of battleId/trackId should
// be set (Prisma/Postgres can't enforce that at the schema level, so it's
// validated in application code). No releaseId yet — Release isn't modeled.
model Comment {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  body   String

  battleId String? @db.Uuid
  battle   Battle? @relation(fields: [battleId], references: [id], onDelete: Cascade)
  trackId  String? @db.Uuid
  track    Track?  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  parentId String?   @db.Uuid
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
}

// --- Admin (build-order step 6) ---------------------------------------------

enum DisputeStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Filed against a Battle or a Submission — at most one of battleId/
// submissionId is expected to be set (validated in application code, same
// as Comment's battleId/trackId).
model Dispute {
  id        String @id @default(uuid()) @db.Uuid
  filedById String @db.Uuid
  filedBy   User   @relation(fields: [filedById], references: [id], onDelete: Cascade)

  battleId     String?     @db.Uuid
  battle       Battle?     @relation(fields: [battleId], references: [id], onDelete: Cascade)
  submissionId String?     @db.Uuid
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  reason     String
  status     DisputeStatus @default(OPEN)
  resolution String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
